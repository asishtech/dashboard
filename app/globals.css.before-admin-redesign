* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  background: #f4f6f9;
  color: #172033;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body {
  min-height: 100vh;
}

button,
input,
select,
textarea {
  font: inherit;
}

.dashboard {
  min-height: 100vh;
  padding: 32px;
  background: #f4f6f9;
  color: #172033;
}

.container {
  width: 100%;
  max-width: 1700px;
  margin: 0 auto;
}

/* HEADER */

.header {
  position: relative;
  padding: 28px 30px;
  border-radius: 16px;
  background: #111827;
  color: #ffffff;
  margin-bottom: 20px;
}

.header h1 {
  margin: 0;
  font-size: 25px;
  font-weight: 700;
  letter-spacing: -0.3px;
}

.header p {
  margin: 7px 0 0;
  color: #cbd5e1;
  font-size: 14px;
}

.updated {
  margin-top: 18px;
  color: #cbd5e1;
  font-size: 12px;
  line-height: 1.7;
}

.live-status {
  position: absolute;
  right: 28px;
  top: 28px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 7px 11px;
  border-radius: 999px;

  background: #1f2937;
  border: 1px solid #374151;

  color: #d1fae5;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
}

/* ERROR */

.error-box {
  margin-bottom: 18px;
  padding: 15px 18px;
  border-radius: 10px;

  background: #fef2f2;
  border: 1px solid #fecaca;

  color: #991b1b;
  font-size: 13px;
}

.error-box div {
  margin-top: 4px;
}

/* STATS */

.stats {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 15px;
  margin-bottom: 18px;
}

.stat-card {
  min-height: 125px;
  padding: 20px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 13px;

  color: #172033;
}

.stat-title {
  color: #64748b;
  font-size: 12px;
  font-weight: 600;
}

.stat-value {
  margin-top: 9px;
  color: #111827;

  font-size: 27px;
  line-height: 1.2;
  font-weight: 750;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-value.compact {
  font-size: 19px;
  padding-top: 3px;
}

.stat-subtitle {
  margin-top: 7px;
  color: #16a34a;
  font-size: 12px;
  font-weight: 600;
}

/* MERCHANDISE */

.merchandise-panel {
  margin-bottom: 18px;
  padding: 20px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 13px;

  color: #172033;
}

.section-title {
  margin-bottom: 17px;

  color: #172033;
  font-size: 15px;
  font-weight: 700;
}

.merchandise-list {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.merchandise-row {
  display: grid;
  grid-template-columns: minmax(180px, 320px) 1fr 55px;
  gap: 14px;
  align-items: center;
}

.merchandise-name {
  display: flex;
  justify-content: space-between;
  gap: 10px;

  color: #1f2937;
  font-size: 13px;
}

.merchandise-name strong {
  color: #111827;
}

.bar {
  height: 8px;
  overflow: hidden;

  background: #e5e7eb;
  border-radius: 999px;
}

.bar-fill {
  height: 100%;
  min-width: 4px;

  background: #2563eb;
  border-radius: 999px;

  transition: width 0.4s ease;
}

.percentage {
  color: #64748b;
  font-size: 12px;
  text-align: right;
}

/* SEARCH */

.search-panel {
  margin-bottom: 15px;
  padding: 14px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.search-panel input {
  width: 100%;
  height: 44px;

  padding: 0 14px;

  border: 1px solid #cbd5e1;
  border-radius: 8px;

  background: #ffffff;
  color: #111827;

  outline: none;
}

.search-panel input::placeholder {
  color: #94a3b8;
}

.search-panel input:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

/* TABLE */

.table-card {
  overflow: hidden;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 13px;

  color: #172033;
}

.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 17px 20px;

  border-bottom: 1px solid #e5e7eb;
}

.table-header h2 {
  margin: 0;

  color: #111827;
  font-size: 15px;
}

.table-header span {
  display: block;
  margin-top: 4px;

  color: #64748b;
  font-size: 12px;
}

.refresh-indicator {
  display: flex !important;
  align-items: center;
  gap: 7px;

  color: #64748b !important;
}

.refresh-dot {
  width: 7px;
  height: 7px;

  background: #22c55e;
  border-radius: 50%;
}

.table-wrapper {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 1500px;

  border-collapse: collapse;

  color: #172033;
  background: #ffffff;
}

thead {
  background: #f8fafc;
}

th {
  padding: 12px 14px;

  color: #475569;
  background: #f8fafc;

  font-size: 11px;
  font-weight: 700;
  text-align: left;

  white-space: nowrap;

  border-bottom: 1px solid #e2e8f0;
}

td {
  padding: 13px 14px;

  color: #334155;
  background: #ffffff;

  font-size: 12px;
  vertical-align: top;

  border-bottom: 1px solid #eef2f7;
}

tbody tr:hover td {
  background: #f8fafc;
}

.primary-text {
  color: #111827;
  font-weight: 650;
}

.email {
  color: #334155;
}

.date {
  color: #475569;
  white-space: nowrap;
}

.id-badge,
.event-badge,
.merchandise-badge {
  display: inline-block;

  padding: 5px 8px;

  border-radius: 6px;

  font-size: 11px;
  font-weight: 650;
}

.id-badge {
  color: #334155;
  background: #f1f5f9;
}

.event-badge {
  color: #1d4ed8;
  background: #eff6ff;
}

.merchandise-badge {
  max-width: 230px;

  color: #166534;
  background: #f0fdf4;

  white-space: normal;
}

.amount {
  color: #111827;
  white-space: nowrap;
}

.invoice {
  display: block;
  margin-top: 4px;
  color: #64748b;
  font-size: 10px;
}

.custom-fields {
  width: 280px;
}

.custom-field {
  margin-bottom: 6px;
  padding: 7px 9px;

  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
}

.field-name {
  margin-bottom: 2px;

  color: #64748b;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.field-value {
  color: #1e293b;
  font-size: 11px;
  word-break: break-word;
}

.muted {
  color: #94a3b8;
}

.empty {
  padding: 50px !important;

  color: #64748b !important;
  background: #ffffff !important;

  text-align: center;
}

/* RESPONSIVE */

@media (max-width: 1000px) {
  .dashboard {
    padding: 18px;
  }

  .stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .live-status {
    position: static;
    width: fit-content;
    margin-top: 15px;
  }

  .merchandise-row {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .percentage {
    text-align: left;
  }
}

@media (max-width: 600px) {
  .dashboard {
    padding: 10px;
  }

  .header {
    padding: 20px;
  }

  .header h1 {
    font-size: 21px;
  }

  .stats {
    grid-template-columns: 1fr;
  }
}

/* INVENTORY DASHBOARD */

.inventory-panel {
  margin-bottom: 18px;
  padding: 22px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 13px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 20px;
}

.section-header h2,
.sales-panel h2,
.countdown-panel h2 {
  margin: 0;

  color: #111827;
  font-size: 16px;
}

.section-header span,
.panel-subtitle,
.countdown-header p {
  display: block;
  margin-top: 5px;

  color: #64748b;
  font-size: 12px;
}

.stock-total {
  padding: 7px 11px;

  color: #166534;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;

  border-radius: 999px;

  font-size: 12px;
  font-weight: 700;
}

.inventory-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;
}

.inventory-card {
  padding: 18px;

  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 11px;
}

.inventory-card.critical-card {
  background: #fff7f7;
  border-color: #fecaca;
}

.inventory-card-header {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.inventory-card h3 {
  margin: 0;

  color: #1e293b;
  font-size: 14px;
}

.inventory-card-header span {
  display: block;
  margin-top: 4px;

  color: #64748b;
  font-size: 11px;
}

.stock-number {
  color: #111827;
  font-size: 30px;
  line-height: 1;
  font-weight: 800;
}

.inventory-label {
  margin-top: 4px;

  color: #64748b;
  font-size: 10px;
}

.inventory-track {
  height: 9px;
  margin-top: 15px;

  overflow: hidden;

  background: #e2e8f0;
  border-radius: 999px;
}

.inventory-fill {
  height: 100%;
  background: #16a34a;
  border-radius: 999px;
  transition: width 0.4s ease;
}

.inventory-fill.warning {
  background: #f59e0b;
}

.inventory-fill.critical {
  background: #dc2626;
}

.inventory-footer {
  display: flex;
  justify-content: space-between;

  margin-top: 9px;

  color: #64748b;
  font-size: 10px;
}

.inventory-footer strong {
  color: #334155;
}

/* SALES */

.sales-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
  margin-bottom: 18px;
}

.sales-panel {
  padding: 20px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 13px;
}

.panel-subtitle {
  margin-bottom: 16px;
}

.sale-row {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 11px 0;

  color: #334155;
  font-size: 13px;

  border-bottom: 1px solid #eef2f7;
}

.sale-row:last-child {
  border-bottom: 0;
}

.sale-row strong {
  color: #111827;
}

/* COUNTDOWN */

.countdown-panel {
  margin-bottom: 18px;
  padding: 22px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 13px;
}

.countdown-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 22px;
}

.countdown-header p {
  margin-bottom: 0;
}

.countdown-total {
  min-width: 80px;

  color: #111827;

  font-size: 28px;
  font-weight: 800;

  text-align: right;
}

.countdown-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.countdown-row {
  display: grid;

  grid-template-columns:
    200px
    1fr
    70px;

  gap: 15px;
  align-items: center;
}

.countdown-name strong {
  display: block;

  color: #1e293b;
  font-size: 13px;
}

.countdown-name span {
  display: block;
  margin-top: 3px;

  color: #64748b;
  font-size: 10px;
}

.countdown-track {
  height: 10px;

  overflow: hidden;

  background: #e2e8f0;
  border-radius: 999px;
}

.countdown-fill {
  height: 100%;

  background: #2563eb;
  border-radius: 999px;

  transition:
    width 0.5s ease,
    background 0.3s ease;
}

.countdown-fill.warning {
  background: #f59e0b;
}

.countdown-fill.critical {
  background: #dc2626;
}

.remaining-number {
  color: #111827;

  font-size: 18px;
  font-weight: 800;

  text-align: right;
}

.critical-text {
  color: #dc2626 !important;
}

/* MERCHANDISE TAGS */

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;

  width: 240px;
}

.item-tag {
  padding: 5px 7px;

  color: #1d4ed8;
  background: #eff6ff;

  border-radius: 5px;

  font-size: 10px;
  font-weight: 650;
}

.type-badge {
  display: inline-block;

  padding: 5px 8px;

  border-radius: 999px;

  font-size: 10px;
  font-weight: 700;
}

.type-badge.combo {
  color: #7c2d12;
  background: #ffedd5;
}

.type-badge.single {
  color: #166534;
  background: #dcfce7;
}

@media (max-width: 1100px) {
  .inventory-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .countdown-row {
    grid-template-columns:
      160px
      1fr
      60px;
  }
}

@media (max-width: 700px) {
  .inventory-grid,
  .sales-grid {
    grid-template-columns: 1fr;
  }

  .section-header,
  .countdown-header {
    align-items: flex-start;
    gap: 15px;
  }

  .countdown-row {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .remaining-number {
    text-align: left;
  }
}

.admin-link {
  color: inherit;
  text-decoration: none;
  font-weight: 600;
}

.admin-card {
  text-decoration: none;
  color: inherit;
  transition: transform .2s ease, box-shadow .2s ease;
}

.admin-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(0,0,0,.08);
}

.admin-icon {
  font-size: 38px;
  margin-bottom: 12px;
}

.admin-arrow {
  display: inline-block;
  margin-top: 15px;
  font-weight: 700;
}

.quantity-input {
  width: 110px;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 15px;
}

.save-button {
  border: none;
  border-radius: 9px;
  padding: 11px 18px;
  background: #111827;
  color: white;
  font-weight: 700;
  cursor: pointer;
}

.save-button:hover {
  opacity: .9;
}

.save-button:disabled {
  opacity: .5;
  cursor: not-allowed;
}

.qr-button {
  display: inline-block;
  padding: 8px 12px;
  border-radius: 8px;
  background: #111827;
  color: white;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
}

.error-banner {
  padding: 14px 18px;
  border-radius: 10px;
  margin-bottom: 20px;
  background: #fff1f2;
  color: #be123c;
}



/* ============================================================
   GLOBAL LOADING
   ============================================================ */

.loading-screen {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fb;
  padding: 24px;
}

.loading-card {
  width: 100%;
  max-width: 360px;
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 30px;
  text-align: center;
  box-shadow:
    0 15px 45px rgba(0, 0, 0, 0.08);
}

.loading-spinner {
  width: 42px;
  height: 42px;
  margin: 0 auto 20px;
  border: 4px solid #e5e7eb;
  border-top-color: #111827;
  border-radius: 50%;
  animation: vtapp-spin 0.8s linear infinite;
}

.loading-card h2 {
  margin: 0 0 8px;
  font-size: 20px;
}

.loading-card p {
  margin: 0;
  color: #64748b;
  font-size: 14px;
}

@keyframes vtapp-spin {
  to {
    transform: rotate(360deg);
  }
}


/* ============================================================
   BUTTON LOADING
   ============================================================ */

.loading-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: wait;
  opacity: 0.7;
}

.loading-button-spinner {
  width: 15px;
  height: 15px;
  border: 2px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: vtapp-spin 0.7s linear infinite;
}


/* ============================================================
   DATA SKELETON
   ============================================================ */

.skeleton {
  background: linear-gradient(
    90deg,
    #eef1f5 25%,
    #f8fafc 50%,
    #eef1f5 75%
  );
  background-size: 200% 100%;
  animation: vtapp-skeleton 1.4s infinite;
  border-radius: 8px;
}

.skeleton-card {
  height: 150px;
  border-radius: 14px;
}

.skeleton-line {
  height: 14px;
  margin-bottom: 10px;
}

.skeleton-line.short {
  width: 45%;
}

.skeleton-line.medium {
  width: 70%;
}

.skeleton-line.full {
  width: 100%;
}

@keyframes vtapp-skeleton {
  from {
    background-position: 200% 0;
  }

  to {
    background-position: -200% 0;
  }
}

/* =========================================================
   V-TAPP 2026 ADMIN CONTROL UI
   ========================================================= */

:root {
  --vt-bg: #050505;
  --vt-panel: #0a0a0a;
  --vt-panel-2: #0e0e0e;
  --vt-green: #c7ff00;
  --vt-green-dim: #8eae00;
  --vt-text: #f1f1f1;
  --vt-muted: #777;
  --vt-border: #242424;
  --vt-grid: rgba(199, 255, 0, 0.055);
}

body {
  background:
    linear-gradient(var(--vt-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--vt-grid) 1px, transparent 1px),
    var(--vt-bg) !important;
  background-size: 40px 40px !important;
  color: var(--vt-text);
  font-family:
    "SFMono-Regular",
    "SF Mono",
    Menlo,
    Monaco,
    Consolas,
    "Liberation Mono",
    monospace !important;
}

/* Main dashboard */

.dashboard {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 80% 10%,
      rgba(199,255,0,.055),
      transparent 30%
    ),
    transparent !important;
}

.dashboard .container {
  max-width: 1500px;
}

/* Header */

.dashboard .header {
  position: relative;
  border-bottom: 1px solid var(--vt-border);
  padding: 28px 0;
  margin-bottom: 28px;
}

.dashboard .header::before {
  content: "V-TAPP / 2026";
  display: block;
  color: var(--vt-green);
  font-size: 12px;
  letter-spacing: .18em;
  margin-bottom: 12px;
}

.dashboard .header h1 {
  color: #fff;
  font-size: clamp(28px, 4vw, 52px);
  letter-spacing: -.04em;
  text-transform: uppercase;
  margin: 0;
}

.dashboard .header p {
  color: var(--vt-muted);
  font-size: 12px;
  letter-spacing: .12em;
  text-transform: uppercase;
}

/* Navigation */

.dashboard .admin-link {
  color: var(--vt-text) !important;
  border: 1px solid var(--vt-border);
  background: #080808;
  border-radius: 0 !important;
  padding: 9px 13px;
  font-family: inherit;
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;
  transition: all .15s ease;
}

.dashboard .admin-link:hover {
  color: var(--vt-green) !important;
  border-color: var(--vt-green);
  box-shadow: 0 0 16px rgba(199,255,0,.12);
}

/* KPI section */

.dashboard .stats {
  display: grid;
  grid-template-columns:
    repeat(5, minmax(0, 1fr));
  gap: 1px;
  background: var(--vt-border);
  border: 1px solid var(--vt-border);
}

.dashboard .stat-card {
  background: var(--vt-panel);
  border-radius: 0 !important;
  padding: 22px;
  min-height: 145px;
  position: relative;
}

.dashboard .stat-card::before {
  content: "■";
  position: absolute;
  top: 12px;
  right: 14px;
  color: var(--vt-green);
  font-size: 7px;
}

.dashboard .stat-title {
  color: #777;
  font-size: 10px;
  letter-spacing: .13em;
  text-transform: uppercase;
}

.dashboard .stat-value {
  color: var(--vt-green);
  font-family: inherit;
  font-size: 34px;
  font-weight: 700;
  line-height: 1;
  margin: 18px 0 10px;
  letter-spacing: -.04em;
}

.dashboard .stat-subtitle {
  color: #555;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .08em;
}

/* Panels */

.dashboard .sales-grid {
  gap: 1px !important;
  background: var(--vt-border);
  border: 1px solid var(--vt-border);
}

.dashboard .sales-panel,
.dashboard .admin-card,
.dashboard .inventory-panel {
  background: var(--vt-panel) !important;
  border-radius: 0 !important;
  border: 0 !important;
}

.dashboard .admin-card {
  padding: 25px !important;
  position: relative;
}

.dashboard .admin-card::before {
  content: "[ CONTROL ]";
  color: var(--vt-green);
  font-size: 9px;
  letter-spacing: .14em;
}

.dashboard .admin-card h2 {
  color: #fff;
  text-transform: uppercase;
  letter-spacing: -.02em;
  margin-top: 18px;
}

.dashboard .admin-card .panel-subtitle {
  color: #666;
  font-size: 11px;
  line-height: 1.7;
}

.dashboard .admin-arrow {
  color: var(--vt-green) !important;
  font-size: 11px;
  text-transform: uppercase;
}

/* Inventory */

.dashboard .inventory-panel {
  margin-top: 28px;
  padding: 25px;
  border: 1px solid var(--vt-border) !important;
}

.dashboard .section-header {
  border-bottom: 1px solid var(--vt-border);
  padding-bottom: 18px;
  margin-bottom: 18px;
}

.dashboard .section-header h2 {
  color: #fff;
  text-transform: uppercase;
  letter-spacing: -.03em;
}

.dashboard .section-header span {
  color: #555;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .1em;
}

/* Inventory cards */

.dashboard .inventory-grid {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(250px, 1fr));
  gap: 1px;
  background: var(--vt-border);
  border: 1px solid var(--vt-border);
}

.dashboard .inventory-card {
  background: var(--vt-panel-2);
  border-radius: 0 !important;
  padding: 20px;
  border: 0 !important;
}

.dashboard .inventory-card-header h3 {
  color: #fff;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: .05em;
}

.dashboard .inventory-card-header span {
  color: #555;
  font-size: 10px;
}

.dashboard .stock-number {
  color: var(--vt-green) !important;
  font-size: 36px !important;
  font-family: inherit;
  font-weight: 800;
}

.dashboard .inventory-label {
  color: #555;
  font-size: 9px;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.dashboard .inventory-track {
  background: #181818 !important;
  border-radius: 0 !important;
  height: 5px !important;
}

.dashboard .inventory-fill {
  background: var(--vt-green) !important;
  box-shadow: 0 0 10px rgba(199,255,0,.25);
}

.dashboard .inventory-footer {
  margin-top: 14px;
  color: #777;
  font-size: 10px;
  text-transform: uppercase;
}

.dashboard .inventory-footer span {
  color: #fff;
}

.dashboard .inventory-footer strong {
  color: var(--vt-green);
}

/* Force refresh */

.dashboard button {
  font-family: inherit !important;
  border-radius: 0 !important;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.dashboard button:hover {
  border-color: var(--vt-green) !important;
}

/* Loading */

.dashboard .skeleton {
  background:
    linear-gradient(
      90deg,
      #101010 25%,
      #1a1a1a 50%,
      #101010 75%
    ) !important;
  background-size: 200% 100%;
  animation: vt-skeleton 1.2s infinite;
}

@keyframes vt-skeleton {
  from {
    background-position: 200% 0;
  }
  to {
    background-position: -200% 0;
  }
}

/* Status / system text */

.dashboard::after {
  content:
    "V-TAPP 2026  //  ADMIN CONTROL  //  SYSTEM ONLINE";
  display: block;
  max-width: 1500px;
  margin: 35px auto 0;
  padding: 18px 20px;
  border-top: 1px solid var(--vt-border);
  color: #444;
  font-size: 9px;
  letter-spacing: .12em;
}

/* Mobile */

@media (max-width: 900px) {
  .dashboard .stats {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .dashboard .stats {
    grid-template-columns: 1fr;
  }

  .dashboard .header h1 {
    font-size: 30px;
  }

  .dashboard .inventory-grid {
    grid-template-columns: 1fr;
  }
}
