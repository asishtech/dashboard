    min-height: auto;
  }

}


/* =========================================================
   ADMIN DASHBOARD — DISTRIBUTION / ANALYTICS POLISH
   ========================================================= */

/* Keep dashboard analytics balanced */
.sales-grid,
.analytics-grid {
  align-items: stretch;
}

/* Chart cards */
.chart-card {
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
}

/* Distribution card should use the available width */
.chart-card:has(.distribution-circle),
.distribution-card {
  width: 100%;
  min-height: 220px;
  box-sizing: border-box;
}

/* Distribution content */
.distribution-grid,
.distribution-circles,
.distribution-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56px;
  width: 100%;
  padding: 28px 20px 24px;
  box-sizing: border-box;
}

/* Individual distribution item */
.distribution-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120px;
}

/* Circle */
.distribution-circle {
  width: 108px !important;
  height: 108px !important;
  min-width: 108px;
  min-height: 108px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  position: relative;
}

/* Big number inside circle */
.distribution-circle strong,
.distribution-circle .value,
.distribution-circle-value {
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 27px !important;
  line-height: 1;
  font-weight: 900;
  color: #111827 !important;
  opacity: 1 !important;
}

/* Percentage */
.distribution-circle span,
.distribution-circle .percentage,
.distribution-circle-percent {
  margin-top: 7px;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 11px !important;
  line-height: 1;
  font-weight: 700;
  color: #475569 !important;
  opacity: 1 !important;
}

/* Circle labels */
.distribution-item > label,
.distribution-item > span:last-child,
.distribution-label {
  margin-top: 12px;
  font-size: 12px !important;
  font-weight: 800;
  letter-spacing: .04em;
  color: #e5e7eb !important;
  text-transform: uppercase;
}

/* Given circle */
.distribution-circle.given {
  border: 8px solid #16251a !important;
  background: #d9f99d !important;
}

/* Pending circle */
.distribution-circle.pending {
  border: 8px solid #334155 !important;
  background: #f1f5f9 !important;
}

/* Better status text */
.distribution-circle.given strong,
.distribution-circle.given .value {
  color: #172000 !important;
}

.distribution-circle.pending strong,
.distribution-circle.pending .value {
  color: #111827 !important;
}

/* Percentage text */
.distribution-circle.given span,
.distribution-circle.given .percentage {
  color: #365314 !important;
}

.distribution-circle.pending span,
.distribution-circle.pending .percentage {
  color: #475569 !important;
}


/* =========================================================
   SALES + INVENTORY CHARTS
   ========================================================= */

.chart-card h2 {
  color: #f8fafc;
  font-weight: 800;
  letter-spacing: -.02em;
}

.chart-card .panel-subtitle {
  color: #94a3b8;
}

.chart-row {
  margin-top: 18px;
}

.chart-label {
  color: #cbd5e1;
  font-size: 12px;
  font-weight: 600;
}

.chart-number {
  color: #f8fafc;
  font-family: "SFMono-Regular", Consolas, monospace;
