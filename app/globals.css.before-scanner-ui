/* =========================================================
   VTAAP REGISTRATION CONTROL
   ========================================================= */

.registration-row {
  display: grid;
  grid-template-columns:
    minmax(230px, 1.5fr)
    minmax(150px, 1fr)
    minmax(150px, .9fr)
    minmax(120px, .7fr)
    minmax(110px, .6fr);

  align-items: center;
  min-height: 82px;
  padding: 16px 18px;

  border-bottom: 1px solid var(--vt-border, #242a2f);
  background: #080b0d;

  transition:
    background .15s ease,
    border-color .15s ease;
}

.registration-row:last-child {
  border-bottom: 0;
}

.registration-row:not(.registration-header):hover {
  background: #0e1316;
  border-bottom-color: #3a4248;
}

.registration-row > div {
  min-width: 0;
  padding-right: 18px;
}

.registration-row > div:last-child {
  padding-right: 0;
}

.registration-header {
  min-height: 42px;
  background: #11161a;
  border-bottom: 1px solid #424a50;

  color: #7d8992;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size: 8px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.registration-header > span {
  min-width: 0;
}


/* buyer */

.registration-row strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* registration ID */

.registration-row > div:nth-child(2) {
  overflow: hidden;
}


/* merchandise */

.registration-row > div:nth-child(3) {
  text-align: left;
}


/* amount */

.registration-row > div:nth-child(4) {
  text-align: left;
}


/* status */

.registration-row > div:nth-child(5) {
  display: flex;
  align-items: center;
}


/* =========================================================
   REGISTRATION PAGE SEARCH
   ========================================================= */

.registration-search {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
  margin-bottom: 18px;
}

.registration-search input {
  box-sizing: border-box;
}


/* =========================================================
   REGISTRATION TABLE FRAME
   ========================================================= */

.registration-table {
  width: 100%;
  overflow: hidden;

  border: 1px solid var(--vt-border, #242a2f);
  background: #080b0d;
}


/* =========================================================
   REGISTRATION STATS
   ========================================================= */

.registration-stat-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 1px;

  background: var(--vt-border, #242a2f);
  border: 1px solid var(--vt-border, #242a2f);
}

.registration-stat-grid > * {
  min-width: 0;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {

  .registration-row {
    grid-template-columns:
      1.5fr
      .8fr
      .8fr
      .7fr
      .7fr;

    padding: 14px;
  }

  .registration-row > div {
    padding-right: 10px;
  }

}


@media (max-width: 700px) {

  .registration-search {
    grid-template-columns: 1fr;
  }

  .registration-row {
    display: block;
    padding: 18px;
  }

  .registration-header {
    display: none;
  }

  .registration-row > div {
    display: flex;
