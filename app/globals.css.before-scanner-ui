/* =========================================================
   VOLUNTEER — ADMIN VISUAL SYSTEM
   Keep scanner logic untouched; only unify presentation.
   ========================================================= */

:root {
  --vol-bg: #030506;
  --vol-surface: #090c0f;
  --vol-surface-2: #0c1014;
  --vol-border: #252b33;
  --vol-border-strong: #303640;

  --vol-text: #f4f4f5;
  --vol-muted: #8b8f98;
  --vol-dim: #626975;

  --vol-orange: #f97316;
  --vol-orange-bright: #fb923c;

  --vol-purple: #8b5cf6;
  --vol-purple-bright: #c084fc;

  --vol-green: #4ade80;
  --vol-red: #f87171;
}

/* Main volunteer shell */

main.dashboard {
  background:
    linear-gradient(
      rgba(3, 5, 6, .96),
      rgba(3, 5, 6, .96)
    ),
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 39px,
      rgba(255,255,255,.025) 40px
    ),
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 39px,
      rgba(255,255,255,.025) 40px
    );

  color: var(--vol-text);
  min-height: 100vh;
}

/* Header */

main.dashboard .header {
  border-bottom: 1px solid var(--vol-border);
  padding-bottom: 24px;
  margin-bottom: 24px;
}

main.dashboard .header h1 {
  color: var(--vol-text);
  letter-spacing: -.025em;
}

main.dashboard .header p {
  color: var(--vol-muted);
}

/* Back/dashboard links */

main.dashboard .admin-link {
  color: var(--vol-orange-bright);
  border-color: var(--vol-border);
  background: transparent;
  transition:
    background .18s ease,
    border-color .18s ease,
    color .18s ease;
}

main.dashboard .admin-link:hover {
  color: #fff;
  border-color: var(--vol-orange);
  background: rgba(249,115,22,.08);
}

/* Scanner landing card */

main.dashboard .sales-panel {
  background:
    linear-gradient(
      145deg,
      rgba(10,14,18,.98),
      rgba(6,9,12,.98)
    );

  border: 1px solid var(--vol-border);
  box-shadow:
    0 20px 60px rgba(0,0,0,.28);
}

/* Scanner icon */

main.dashboard .sales-panel > div > div:first-child {
  color: var(--vol-orange-bright);
  filter:
    drop-shadow(
      0 0 20px rgba(249,115,22,.18)
    );
}

/* Scanner headings */

main.dashboard .sales-panel h2 {
  color: var(--vol-text);
  letter-spacing: -.02em;
}

main.dashboard .panel-subtitle {
  color: var(--vol-muted);
}

/* Start Scanner */

main.dashboard .save-button {
  background: var(--vol-orange);
  border: 1px solid var(--vol-orange);
  color: #080808;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;

  font-weight: 900;
  letter-spacing: .08em;

  transition:
    transform .15s ease,
    background .15s ease,
    box-shadow .15s ease;
}

main.dashboard .save-button:hover {
  background: var(--vol-orange-bright);
  border-color: var(--vol-orange-bright);

  box-shadow:
    0 0 25px rgba(249,115,22,.18);

  transform: translateY(-1px);
}

/* =========================================================
   VOLUNTEER SCANNER
   ========================================================= */

.scanner-page,
main.scanner-page {
  background: var(--vol-bg);
  color: var(--vol-text);
}

/* Scanner frame */

.scanner-container,
.scanner-card,
.qr-scanner,
.scan-panel {
  background: var(--vol-surface);
  border-color: var(--vol-border);
}

/* Camera / scanner area */

#reader {
  background: #020304 !important;
  border: 1px solid var(--vol-border-strong) !important;
}

/* Scanner buttons */

.scanner-page button,
.scan-panel button {
  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;
}

/* QR / action buttons */

.scanner-page .qr-button,
.scan-panel .qr-button {
  border: 1px solid var(--vol-orange);
  background: transparent;
  color: var(--vol-orange-bright);
}

.scanner-page .qr-button:hover,
.scan-panel .qr-button:hover {
  background: rgba(249,115,22,.08);
}

/* Given badge */

.type-badge.single {
  border-color: var(--vol-green) !important;
  color: var(--vol-green) !important;
  background: rgba(74,222,128,.07) !important;
}

/* Pending / action badge */

.type-badge.combo {
  border-color: var(--vol-orange) !important;
  color: var(--vol-orange-bright) !important;
  background: rgba(249,115,22,.07) !important;
}

/* Distribution item cards */

.item-card,
.distribution-item,
.merchandise-item {
  background: var(--vol-surface-2);
  border-color: var(--vol-border);
}

/* Strong text */

.item-card strong,
.distribution-item strong,
.merchandise-item strong {
  color: var(--vol-text);
}

/* Secondary item information */

.item-card div,
.distribution-item div,
.merchandise-item div {
  color: var(--vol-muted);
}

/* Mark as given */

.item-card button,
.distribution-item button,
.merchandise-item button {
  border-color: var(--vol-orange);
  background: var(--vol-orange);
  color: #080808;
}

.item-card button:hover,
.distribution-item button:hover,
.merchandise-item button:hover {
  background: var(--vol-orange-bright);
}

/* Disabled */

button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

/* Error */

.error,
.scan-error {
  border-color: rgba(248,113,113,.45);
  color: var(--vol-red);
  background: rgba(248,113,113,.06);
}

/* Success */

.success,
.scan-success {
  border-color: rgba(74,222,128,.4);
  color: var(--vol-green);
  background: rgba(74,222,128,.06);
}

/* Mobile */

@media (max-width: 700px) {
  main.dashboard .container {
    padding-left: 16px;
    padding-right: 16px;
  }

  main.dashboard .header {
    gap: 16px;
  }

  main.dashboard .sales-panel {
    width: 100%;
  }
}


/* =========================================================
   VOLUNTEER — ADMIN VISUAL SYSTEM
   Keep scanner logic untouched; only unify presentation.
   ========================================================= */

:root {
  --vol-bg: #030506;
  --vol-surface: #090c0f;
  --vol-surface-2: #0c1014;
  --vol-border: #252b33;
  --vol-border-strong: #303640;

  --vol-text: #f4f4f5;
  --vol-muted: #8b8f98;
  --vol-dim: #626975;

  --vol-orange: #f97316;
  --vol-orange-bright: #fb923c;

  --vol-purple: #8b5cf6;
  --vol-purple-bright: #c084fc;

  --vol-green: #4ade80;
  --vol-red: #f87171;
}

/* Main volunteer shell */

main.dashboard {
  background:
    linear-gradient(
      rgba(3, 5, 6, .96),
      rgba(3, 5, 6, .96)
    ),
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 39px,
      rgba(255,255,255,.025) 40px
    ),
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 39px,
      rgba(255,255,255,.025) 40px
    );

  color: var(--vol-text);
  min-height: 100vh;
}

/* Header */

main.dashboard .header {
  border-bottom: 1px solid var(--vol-border);
  padding-bottom: 24px;
  margin-bottom: 24px;
}

main.dashboard .header h1 {
  color: var(--vol-text);
  letter-spacing: -.025em;
}

main.dashboard .header p {
  color: var(--vol-muted);
}

/* Back/dashboard links */

main.dashboard .admin-link {
  color: var(--vol-orange-bright);
  border-color: var(--vol-border);
  background: transparent;
  transition:
    background .18s ease,
    border-color .18s ease,
    color .18s ease;
}

main.dashboard .admin-link:hover {
  color: #fff;
  border-color: var(--vol-orange);
  background: rgba(249,115,22,.08);
}

/* Scanner landing card */

main.dashboard .sales-panel {
  background:
    linear-gradient(
      145deg,
      rgba(10,14,18,.98),
      rgba(6,9,12,.98)
    );

  border: 1px solid var(--vol-border);
  box-shadow:
    0 20px 60px rgba(0,0,0,.28);
}

/* Scanner icon */

main.dashboard .sales-panel > div > div:first-child {
  color: var(--vol-orange-bright);
  filter:
    drop-shadow(
      0 0 20px rgba(249,115,22,.18)
    );
}

/* Scanner headings */

main.dashboard .sales-panel h2 {
  color: var(--vol-text);
  letter-spacing: -.02em;
}

main.dashboard .panel-subtitle {
  color: var(--vol-muted);
}

/* Start Scanner */

main.dashboard .save-button {
  background: var(--vol-orange);
  border: 1px solid var(--vol-orange);
  color: #080808;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;

  font-weight: 900;
  letter-spacing: .08em;

  transition:
    transform .15s ease,
    background .15s ease,
    box-shadow .15s ease;
}

main.dashboard .save-button:hover {
  background: var(--vol-orange-bright);
  border-color: var(--vol-orange-bright);

  box-shadow:
    0 0 25px rgba(249,115,22,.18);

  transform: translateY(-1px);
}

/* =========================================================
   VOLUNTEER SCANNER
   ========================================================= */

.scanner-page,
main.scanner-page {
  background: var(--vol-bg);
  color: var(--vol-text);
}

/* Scanner frame */

.scanner-container,
.scanner-card,
.qr-scanner,
.scan-panel {
  background: var(--vol-surface);
  border-color: var(--vol-border);
}

/* Camera / scanner area */

#reader {
  background: #020304 !important;
  border: 1px solid var(--vol-border-strong) !important;
}

/* Scanner buttons */

.scanner-page button,
.scan-panel button {
  font-family:
    "SFMono-Regular",
    Consolas,
    monospace;
}

/* QR / action buttons */

.scanner-page .qr-button,
.scan-panel .qr-button {
  border: 1px solid var(--vol-orange);
  background: transparent;
  color: var(--vol-orange-bright);
}

.scanner-page .qr-button:hover,
.scan-panel .qr-button:hover {
  background: rgba(249,115,22,.08);
}

/* Given badge */

.type-badge.single {
  border-color: var(--vol-green) !important;
  color: var(--vol-green) !important;
  background: rgba(74,222,128,.07) !important;
}

/* Pending / action badge */

.type-badge.combo {
  border-color: var(--vol-orange) !important;
  color: var(--vol-orange-bright) !important;
  background: rgba(249,115,22,.07) !important;
}

/* Distribution item cards */

.item-card,
.distribution-item,
.merchandise-item {
  background: var(--vol-surface-2);
  border-color: var(--vol-border);
}

/* Strong text */

.item-card strong,
.distribution-item strong,
.merchandise-item strong {
  color: var(--vol-text);
}

/* Secondary item information */

.item-card div,
.distribution-item div,
.merchandise-item div {
  color: var(--vol-muted);
}

/* Mark as given */

.item-card button,
.distribution-item button,
.merchandise-item button {
  border-color: var(--vol-orange);
  background: var(--vol-orange);
  color: #080808;
}

.item-card button:hover,
.distribution-item button:hover,
.merchandise-item button:hover {
  background: var(--vol-orange-bright);
}

/* Disabled */

button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

/* Error */

.error,
.scan-error {
  border-color: rgba(248,113,113,.45);
  color: var(--vol-red);
  background: rgba(248,113,113,.06);
}

/* Success */

.success,
.scan-success {
  border-color: rgba(74,222,128,.4);
  color: var(--vol-green);
  background: rgba(74,222,128,.06);
}

/* Mobile */

@media (max-width: 700px) {
  main.dashboard .container {
    padding-left: 16px;
    padding-right: 16px;
  }

  main.dashboard .header {
    gap: 16px;
  }

  main.dashboard .sales-panel {
    width: 100%;
  }
}

