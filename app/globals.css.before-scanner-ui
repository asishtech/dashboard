  }

  .registration-row > div:nth-child(3)::before {
    content: "MERCHANDISE";
  }

  .registration-row > div:nth-child(4)::before {
    content: "AMOUNT";
  }

  .registration-row > div:nth-child(5)::before {
    content: "STATUS";
  }

