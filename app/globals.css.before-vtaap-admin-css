/* ============================================================
   V-TAPP 2026 — ADMIN CONTROL CENTER
   Complete high-contrast redesign
   ============================================================ */

:root {
  --vt-bg: #050708;
  --vt-surface: #0c1013;
  --vt-surface-2: #11171b;
  --vt-surface-3: #151d22;

  --vt-border: #29343b;
  --vt-border-soft: #1b252b;

  --vt-white: #f7fafb;
  --vt-text: #dce4e8;
  --vt-muted: #8d9aa2;
  --vt-dim: #65727a;

  --vt-lime: #c8ff25;
  --vt-lime-soft: rgba(200, 255, 37, 0.12);

  --vt-cyan: #65d9ff;
  --vt-cyan-soft: rgba(101, 217, 255, 0.10);

  --vt-red: #ff5d67;
  --vt-orange: #ffb454;

  --vt-radius: 10px;
}

/* ------------------------------------------------------------
   BASE
   ------------------------------------------------------------ */

body {
  background:
    radial-gradient(
      circle at 85% 0%,
      rgba(200, 255, 37, 0.045),
      transparent 30%
    ),
    radial-gradient(
      circle at 0% 70%,
      rgba(101, 217, 255, 0.025),
      transparent 28%
    ),
    var(--vt-bg) !important;

  color: var(--vt-text) !important;

  font-family:
    Inter,
    ui-sans-serif,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif !important;
}

/* Subtle technical grid */

.dashboard {
  min-height: 100vh !important;

  background-image:
    linear-gradient(
      rgba(255,255,255,0.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.018) 1px,
      transparent 1px
    ) !important;

  background-size: 48px 48px !important;
}

/* ------------------------------------------------------------
   CONTAINER
   ------------------------------------------------------------ */

.dashboard .container {
  max-width: 1480px !important;
  padding-bottom: 50px !important;
}

/* ------------------------------------------------------------
   HEADER
   ------------------------------------------------------------ */

.dashboard .header {
  position: relative !important;

  display: grid !important;
  grid-template-columns: 1fr auto !important;

  gap: 24px !important;

  padding: 34px !important;
  margin-bottom: 28px !important;

  background:
    linear-gradient(
      135deg,
      #10171c,
      #090d10
    ) !important;

  border: 1px solid var(--vt-border) !important;
  border-radius: 14px !important;

  box-shadow:
    0 20px 60px rgba(0,0,0,.35),
    inset 0 1px 0 rgba(255,255,255,.025) !important;
}

/* V-TAPP identifier */

.dashboard .header::before {
  content: "V-TAPP / 2026  •  ADMIN CONTROL CENTER";

  display: block;

  position: absolute;
  top: 17px;
  left: 34px;

  color: var(--vt-lime) !important;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace !important;

  font-size: 10px !important;
  font-weight: 700 !important;

  letter-spacing: .16em !important;
}

/* Title */

.dashboard .header h1 {
  margin-top: 15px !important;

  color: var(--vt-white) !important;

  font-size:
    clamp(30px, 4vw, 48px) !important;

  font-weight: 800 !important;

  letter-spacing: -.045em !important;

  line-height: 1 !important;
}

/* Welcome */

.dashboard .header p {
  margin-top: 12px !important;

  color: var(--vt-muted) !important;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace !important;

  font-size: 11px !important;

  letter-spacing: .08em !important;

  text-transform: uppercase !important;
}

/* ------------------------------------------------------------
   NAVIGATION
   ------------------------------------------------------------ */

.dashboard .header > div:last-child {
  align-self: end !important;
}

.dashboard .admin-link {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  min-height: 38px !important;

  padding: 0 15px !important;

  background: #0a0e11 !important;

  color: var(--vt-text) !important;

  border: 1px solid var(--vt-border) !important;
  border-radius: 7px !important;

  font-family:
    "SFMono-Regular",
    Consolas,
    monospace !important;

  font-size: 10px !important;
  font-weight: 700 !important;

  letter-spacing: .08em !important;

  text-transform: uppercase !important;

  transition:
    background .15s ease,
    border-color .15s ease,
    color .15s ease,
    transform .15s ease !important;
}

.dashboard .admin-link:hover {
  background: var(--vt-lime-soft) !important;

  color: var(--vt-lime) !important;

  border-color: var(--vt-lime) !important;

  transform: translateY(-1px) !important;
