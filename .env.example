# V-TAPP Dashboard — environment
#
# Copy to .env.local for development. On AWS Amplify these go under
# App settings → Environment variables, and amplify.yml carries them
# into the SSR runtime.
#
# .env.local is gitignored. Never commit real values: the service role
# key bypasses every row-level policy in the database.

# ── Supabase ────────────────────────────────────────────────────────
# Project settings → API. The anon key is safe in the browser; the
# service role key is not and must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Upstream V-TAPP feed ────────────────────────────────────────────
# Where registrations are synced from.
VTAPP_API_URL=
VTAPP_API_KEY=

# ── This app ────────────────────────────────────────────────────────
# The public origin, with no trailing slash. Two jobs:
#
#   1. The absolute base for QR links inside emails.
#   2. The fallback when a CDN forwards a request without rewriting the
#      Host header. CloudFront does exactly that: the origin sees
#      "localhost:3000", and without this every redirect -- including
#      the Google sign-in callback -- sends people to their own
#      machine. See lib/origin.ts.
#
# Get this wrong and sign-in breaks, not just the email links.
NEXT_PUBLIC_APP_URL=https://vtapp.co.in

# Where "Register or buy merchandise" sends a student with nothing on
# their account.
NEXT_PUBLIC_EVENTS_PORTAL_URL=https://events.vitap.ac.in

# ── Mail ────────────────────────────────────────────────────────────
# Google Workspace on vtapp.co.in. That domain already publishes
# v=spf1 include:_spf.google.com and routes MX to Google, so mail sent
# through Gmail is SPF-aligned with no DNS changes.
#
# SMTP_PASSWORD is a 16-character App Password, not the account
# password. Create it at myaccount.google.com/apppasswords after
# turning on 2-Step Verification for tickets@vtapp.co.in. Paste it
# without the spaces Google shows.
#
# Until SMTP_USER and SMTP_PASSWORD are both set, nothing sends: every
# send returns "skipped" and the app behaves exactly as it does now.
SMTP_USER=tickets@vtapp.co.in
SMTP_PASSWORD=
MAIL_FROM=tickets@vtapp.co.in
MAIL_FROM_NAME=V-TAPP 2026

# SMTP_USERNAME, SMTP_FROM_EMAIL and SMTP_FROM_NAME are accepted as
# aliases for the three above, since that is what most SMTP tooling
# calls them. The names above win if both are set.

# Where sync failures are reported. Your own address, not the sending
# mailbox — an alert nobody reads is not an alert.
ALERT_EMAIL=

# Defaults, only set these to override:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
