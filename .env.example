# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored -- never commit real keys. In production
# (Netlify) set these in Site config -> Environment variables instead.

# Supabase project URL and public anon key. Both are safe to expose to
# the browser (the anon key is meant to be public and is enforced by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SECRET -- full database access, bypasses RLS. Server-side only.
# Never prefix with NEXT_PUBLIC and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# V-TAPP sync source. The URL is the shared VIT-AP endpoint; the key is
# a SECRET issued for this app.
VTAPP_API_URL=https://events.vitap.ac.in/events/api/vtapp
VTAPP_API_KEY=your-vtapp-api-key

# Public base URL used to build absolute claim links. Localhost for dev;
# set to your deployed origin (e.g. https://your-site.netlify.app) in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000
